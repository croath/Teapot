# Antigravity Google OAuth (baked into teapot-core at compile time).
# Copy to `.env` at the workspace root, or export before `cargo build`.

ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# TelemetryDeck (desktop shell). Empty disables sending.
# Process env wins, then `app-tauri/.env`, then this file.
TELEMETRYDECK_APP_ID=
# TELEMETRYDECK_TEST_MODE=false   # only to send production signals from debug builds
