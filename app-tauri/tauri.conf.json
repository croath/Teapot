{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teaport",
  "version": "0.1.0",
  "identifier": "dev.teaport.app",
  "build": {
    "beforeDevCommand": "cd ../app-ui && bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd ../app-ui && bun run build",
    "frontendDist": "../app-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Teaport",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
