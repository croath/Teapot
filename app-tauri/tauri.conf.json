{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teapot",
  "version": "0.1.0",
  "identifier": "com.cdxtheme.teapot",
  "build": {
    "beforeDevCommand": {
      "script": "bash ../scripts/ensure-sidecar.sh && trunk serve",
      "cwd": "../app-ui"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "bash ../scripts/prepare-sidecar.sh release && trunk build --release",
      "cwd": "../app-ui"
    },
    "frontendDist": "../app-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Teapot",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active"
        },
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/teapotx"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {}
}
